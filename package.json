{
  "name": "janamen-hackathon-mvp",
  "version": "0.8.0",
  "private": true,
  "description": "JanaMen Digital HR hackathon MVP",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write \"server.js\" \"lib/**/*.js\" \"public/**/*.{js,html}\" \"scripts/**/*.js\" \"tests/**/*.js\" \"fixtures/**/*.json\" \"package.json\" \"package-lock.json\" \"compose.yaml\" \".prettierrc.json\" && node scripts/format-css.js --write",
    "format:check": "prettier --check \"server.js\" \"lib/**/*.js\" \"public/**/*.{js,html}\" \"scripts/**/*.js\" \"tests/**/*.js\" \"fixtures/**/*.json\" \"package.json\" \"package-lock.json\" \"compose.yaml\" \".prettierrc.json\" && node scripts/format-css.js --check"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
